# Native RADV is supported on Arch/CachyOS. Ubuntu supplies Docker, not its toolchain.
FROM archlinux@sha256:a25b54cf4b9c0de8752f5417c81810fb41bbfa5cdd6a504a9b6816a3b86b1e59
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
# A fixed signed repository snapshot locks ALL packages and transitive dependencies.
# Keep this date in sync with ci/build-lock.json; never disable package signatures.
RUN printf 'Server = https://archive.archlinux.org/repos/2026/10/20/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist \
    && pacman-key --init && pacman-key --populate archlinux \
    && pacman -Syyuu --noconfirm --needed base-devel clang llvm lld llvm-libs \
       libclc spirv-llvm-translator spirv-tools glslang meson ninja cmake \
       python python-mako python-markupsafe python-ply python-packaging python-yaml \
       git curl wget unzip zip tar pkgconf rsync nasm ccache autoconf automake \
       libtool gettext gperf bison flex texinfo perl help2man ca-certificates \
    && pacman -Q > /opt/plexstation-packages.txt \
    && pacman -Scc --noconfirm
# Existing upstream scripts invoke Ninja without a job limit. Limit both host
# shader compiler and target RADV compilation on 7 GiB hosted runners.
RUN mkdir -p /opt/plexstation/bin \
    && printf '#!/bin/bash\nexec /usr/bin/ninja -j"${BUILD_JOBS:-2}" "$@"\n' > /opt/plexstation/bin/ninja \
    && chmod +x /opt/plexstation/bin/ninja
ENV PATH="/opt/plexstation/bin:${PATH}" \
    NINJA=/opt/plexstation/bin/ninja \
    BUILD_JOBS=2 \
    CCACHE_DIR=/build/ccache \
    CCACHE_MAXSIZE=1G
WORKDIR /src
CMD ["bash", "ci/build-native.sh"]
